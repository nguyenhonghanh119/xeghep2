@page
@model XeGhepApp.Pages.LoginModel
@{
    Layout = null;
}

<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>XeGhép — Đăng nhập tài xế</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        body {
            margin: 0;
            background: #f5f6f8;
            font-family: Inter, Arial, sans-serif;
        }

        .auth-shell {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
        }

        .auth-card {
            width: min(400px, 100%);
            box-sizing: border-box;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 10px 28px rgba(0, 0, 0, .06);
        }

        .brand {
            font-size: 20px;
            font-weight: 800;
        }

        .sub {
            color: #6b7280;
            margin: 5px 0 24px;
        }

        .field {
            margin: 0 0 15px;
        }

        .field label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .field input {
            width: 100%;
            box-sizing: border-box;
            padding: 11px;
            border: 1px solid #d1d5db;
            border-radius: 9px;
        }

        .btn {
            width: 100%;
            padding: 12px;
            border: 0;
            border-radius: 9px;
            background: #2563eb;
            color: #fff;
            font-weight: 700;
        }

        .alert {
            padding: 10px;
            border: 1px solid #fecaca;
            background: #fef2f2;
            color: #b91c1c;
            border-radius: 8px;
            margin-bottom: 15px;
        }

        .foot {
            text-align: center;
            margin-top: 18px;
            font-size: 13px;
        }

        .foot a {
            color: #2563eb;
            font-weight: 700;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <main class="auth-shell">
        <section class="auth-card">
            <div class="brand">XeGhép Tài xế</div>
            <p class="sub">Đăng nhập để quản lý chuyến và yêu cầu đặt chỗ.</p>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert">@Model.ErrorMessage</div>
            }

            <form method="post">
                @Html.AntiForgeryToken()
                <div class="field">
                    <label for="Phone">Số điện thoại</label>
                    <input id="Phone"
                           name="Phone"
                           value="@Model.Phone"
                           autocomplete="username"
                           inputmode="tel"
                           required>
                </div>
                <div class="field">
                    <label for="Password">Mật khẩu</label>
                    <input id="Password"
                           name="Password"
                           type="password"
                           autocomplete="current-password"
                           minlength="8"
                           required>
                </div>
                <button class="btn" type="submit">Đăng nhập</button>
            </form>

            <div class="foot">
                Chưa có tài khoản? <a href="/DangKy">Đăng ký tài xế</a>
            </div>
        </section>
    </main>
</body>
</html>
