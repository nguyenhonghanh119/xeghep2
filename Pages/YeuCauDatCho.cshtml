@page
@model XeGhepApp.Pages.YeuCauDatChoModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>XeGhép — Tài xế — Yêu cầu đặt chỗ</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
<script src="/auth-fetch.js"></script>
</head>
<body>
<div class="shell">
  <aside class="sidebar">
    <div class="brand"><span class="dot-route">X</span><div>XeGhép<small>TÀI XẾ</small></div></div>
    <nav class="side-nav">
      <a href="/Index"><span class="ic">🏠</span> Tổng quan</a>
      <a href="/YeuCauDatCho" class="active">
          <span class="ic">📥</span> Yêu cầu đặt chỗ 
          @if (Model.TotalPendingCount > 0)
          {
            <span class="badge-count" id="pending-count">@Model.TotalPendingCount</span>
          }
      </a>
      <a href="/ChuyenCuaToi"><span class="ic">🧭</span> Chuyến của tôi</a>
      <a href="/ThuNhap"><span class="ic">₫</span> Thu nhập</a>
      <a href="/HoSo"><span class="ic">👤</span> Hồ sơ &amp; giấy tờ</a>
    </nav>
    <div class="sidebar-foot">
        <div class="av">@(Model.Avatar ?? "U")</div>
        <div><b>@Model.FullName</b><span>★ @Model.Rating.ToString("0.0") · Đã duyệt</span><a href="/Login" onclick="return logoutDriver(event)">🚪 Đăng xuất</a></div>
    </div>
  </aside>

  <main class="main">
    <div class="view" id="view-requests">
      <div class="topbar"><div><h1>Yêu cầu đặt chỗ</h1><p>Duyệt yêu cầu từ hành khách cho từng chuyến đã đăng.</p></div></div>

      <div id="requests-list">
        
        @foreach (var trip in Model.TripsWithRequests)
        {
            <div class="trip-group-head" data-trip-id="@trip.TripId">
              <div class="route-strip" style="max-width:420px">
                  <div class="pt">
                      <div class="city" style="font-size:14px">@trip.RouteFrom</div>
                      <div class="sub">@XeGhepApp.Pages.YeuCauDatChoModel.FormatVietnameseDate(trip.DepartureTime) · @trip.DepartureTime.ToString("HH:mm")</div>
                  </div>
                  <div class="route-line"><div class="node start"></div><div class="node end"></div></div>
                  <div class="pt end">
                      <div class="city" style="font-size:14px">@trip.RouteTo</div>
                      <div class="sub">@trip.AvailableSeats ghế trống</div>
                  </div>
              </div>
              <span style="font-size:12.5px;color:var(--ink-faint)">@trip.PendingReqCount yêu cầu chờ duyệt</span>
            </div>

            @foreach (var req in trip.Requests)
            {
                <div class="req-card" data-request-id="@req.BookingId">
                  <div class="av">@(req.Avatar ?? XeGhepApp.Pages.YeuCauDatChoModel.FirstName(req.FullName).Substring(0, 1))</div>
                  <div class="meta">
                      <b>@req.FullName</b> <span class="stars">★ 5.0</span>
                      
                      <div class="tripline">
                          Xin @req.Seats ghế · <span style="color:var(--green);font-weight:600;">@req.TotalAmount.ToString("N0")đ</span> 
                          @if (req.PaymentMethod == "online")
                          {
                              <text>(Chuyển khoản)</text>
                          }
                          else
                          {
                              <text>(Tiền mặt)</text>
                          }
                      </div>
                      <div class="tripline" style="margin-top:2px;">
                          Đón: <b>@req.PickupAddress</b> · Trả: <b>@req.DropoffAddress</b>
                      </div>

                  </div>
                  <div class="actions">
                      <button class="btn btn-green btn-sm" onclick="acceptReq(this)">Chấp nhận</button>
                      <button class="btn btn-coral btn-sm" onclick="rejectReq(this)">Từ chối</button>
                  </div>
                </div>
            }
        }

        @if (!Model.TripsWithRequests.Any())
        {
            <p style="text-align:center; color:var(--ink-soft); padding: 40px 0;">
                Hiện tại không có yêu cầu đặt chỗ nào đang chờ duyệt.
            </p>
        }

      </div>
    </div>
  </main>
</div>

<script src="assets/common.js"></script>
<script>
  function acceptReq(btn) {
    const card = btn.closest('.req-card');
    const requestId = card.dataset.requestId;
    
    btn.disabled = true;
    const originalText = btn.textContent;
    btn.textContent = 'Đang xử lý...';

    fetch('/accept-booking.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ booking_id: requestId })
    })
    .then(res => res.json())
    .then(data => {
        if(data.ok) {
            showToast('Đã chấp nhận yêu cầu! Đang chuyển hướng đến bản đồ điểm đón...');
            window.location.href = '/Index';
        } else {
            showToast(data.message || 'Có lỗi xảy ra', 'error');
            btn.disabled = false;
            btn.textContent = originalText;
        }
    })
    .catch(err => {
        showToast('Lỗi kết nối, vui lòng thử lại.', 'error');
        btn.disabled = false;
        btn.textContent = originalText;
    });
  }

  function rejectReq(btn) {
    const card = btn.closest('.req-card');
    const requestId = card.dataset.requestId;

    askConfirm('Bạn có chắc chắn muốn TỪ CHỐI yêu cầu này?').then(isConfirm => {
    if(!isConfirm) return;

    btn.disabled = true;
    const originalText = btn.textContent;
    btn.textContent = 'Đang xử lý...';

    fetch('/reject-booking.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ booking_id: requestId })
    })
    .then(res => res.json())
    .then(data => {
        if(data.ok) {
            card.style.opacity = '.4';
            
            // Xử lý tạo HTML bằng JS thuần để tránh lỗi Razor parser
            const actions = card.querySelector('.actions');
            actions.innerHTML = '';
            const span = document.createElement('span');
            span.className = 'doc-status rejected';
            span.textContent = 'Đã từ chối';
            actions.appendChild(span);

            updatePendingCount(-1);
        } else {
            showToast(data.message || 'Có lỗi xảy ra', 'error');
            btn.disabled = false;
            btn.textContent = originalText;
        }
    })
    .catch(err => {
        showToast('Lỗi kết nối, vui lòng thử lại.', 'error');
        btn.disabled = false;
        btn.textContent = originalText;
    });
    });
  }

  function updatePendingCount(delta) {
    const el = document.getElementById('pending-count');
    if(el) {
        const next = Math.max(0, parseInt(el.textContent, 10) + delta);
        el.textContent = next;
        if(next === 0) el.style.display = 'none';
    }
  }
</script>
</body>
</html>
