@page
@model XeGhepApp.Pages.RutTienModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>XeGhép — Tài xế — Rút tiền</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
<style>
  .sidebar-foot { position: relative; cursor: pointer; user-select: none; transition: background 0.2s; border-radius: 12px; padding: 10px; margin: 0 -10px; }
  .sidebar-foot:hover { background: rgba(255, 255, 255, 0.08); }
  .profile-dropdown { position: absolute; bottom: calc(100% + 5px); left: 0; right: 0; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 8px; box-shadow: 0 4px 16px rgba(18,33,58,0.15); display: flex; flex-direction: column; gap: 4px; z-index: 100; }
  .profile-dropdown.hidden { display: none !important; }
  .profile-dropdown a { color: var(--navy); padding: 10px 12px; border-radius: 8px; font-size: 13.5px; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 10px; transition: 0.15s; }
  .profile-dropdown a:hover { background: var(--fog); }
  .profile-dropdown a.logout { color: var(--coral); }
  .profile-dropdown a.logout:hover { background: var(--coral-dim); }

  .withdraw-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 20px; align-items: start; }
  @@media (max-width: 980px) { .withdraw-grid { grid-template-columns: 1fr; } }

  .balance-row { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .balance-box { flex: 1; min-width: 200px; background: var(--fog); border-radius: 12px; padding: 14px 16px; }
  .balance-box .lbl { font-size: 12px; color: var(--ink-faint); text-transform: uppercase; letter-spacing: .04em; }
  .balance-box .val { font-family: "IBM Plex Mono", monospace; font-size: 22px; font-weight: 600; color: var(--navy); margin-top: 4px; }
  .balance-box.pending .val { color: #92650E; }

  .form-group { margin-bottom: 16px; }
  .form-group label { display: block; font-size: 13px; font-weight: 600; color: var(--navy); margin-bottom: 6px; }
  .form-group .hint { font-size: 12px; color: var(--ink-faint); margin-top: 4px; }
  .form-control {
    width: 100%; padding: 11px 12px; border: 1px solid var(--line); border-radius: 10px;
    font-size: 14px; font-family: inherit; color: var(--navy); background: #fff;
  }
  .form-control:focus { outline: none; border-color: var(--navy); }
  .amount-input-wrap { position: relative; }
  .amount-input-wrap .suffix {
    position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
    font-size: 13.5px; color: var(--ink-faint); font-weight: 600; pointer-events: none;
  }
  .quick-amounts { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
  .quick-amounts button {
    border: 1px solid var(--line); background: #fff; border-radius: 8px; padding: 6px 12px;
    font-size: 12.5px; font-weight: 600; color: var(--navy); cursor: pointer; transition: .15s;
  }
  .quick-amounts button:hover { background: var(--fog); }

  .bank-options { display: flex; flex-direction: column; gap: 8px; }
  .bank-option {
    border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; display: flex;
    align-items: center; gap: 10px; cursor: pointer; transition: .15s;
  }
  .bank-option:hover { background: var(--fog); }
  .bank-option input[type="radio"] { accent-color: var(--navy); width: 16px; height: 16px; }
  .bank-option .bi { font-size: 13.5px; font-weight: 600; color: var(--navy); }
  .bank-option .bi small { display: block; font-weight: 400; color: var(--ink-faint); font-size: 12px; }

  .new-bank-fields { display: none; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 10px; padding: 12px; background: var(--fog); border-radius: 10px; }
  .new-bank-fields.show { display: grid; }
  .new-bank-fields .full { grid-column: 1 / -1; }

  .alert { border-radius: 10px; padding: 12px 14px; font-size: 13.5px; margin-bottom: 16px; display: flex; gap: 10px; align-items: flex-start; }
  .alert.error { background: var(--coral-dim); color: var(--coral); }
  .alert.success { background: var(--green-dim); color: var(--green); }

  .withdraw-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .withdraw-table th { text-align: left; font-size: 11.5px; text-transform: uppercase; letter-spacing: .04em; color: var(--ink-faint); padding: 8px 10px; border-bottom: 1px solid var(--line); }
  .withdraw-table td { padding: 10px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .withdraw-table tr:last-child td { border-bottom: none; }
  .withdraw-table .amount { font-family: "IBM Plex Mono", monospace; font-weight: 600; }
  .status-pill { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
  .empty-row td { text-align: center; color: var(--ink-faint); padding: 24px 10px; }

  .btn-submit { width: 100%; margin-top: 4px; }
  .info-note { font-size: 12px; color: var(--ink-faint); margin-top: 10px; line-height: 1.5; }
</style>
<script src="/auth-fetch.js"></script>
</head>
<body>
<div class="shell">
  <aside class="sidebar">
    <div class="brand"><span class="dot-route">X</span><div>XeGhép<small>TÀI XẾ</small></div></div>
    <nav class="side-nav">
      <a href="/Index"><span class="ic">🏠</span> Tổng quan</a>
      <a href="/YeuCauDatCho"><span class="ic">📥</span> Yêu cầu đặt chỗ
        @if (Model.PendingCount > 0)
        {
            <span class="badge-count">@Model.PendingCount</span>
        }
      </a>
      <a href="/ChuyenCuaToi"><span class="ic">🧭</span> Chuyến của tôi</a>
      <a href="/ThuNhap" class="active"><span class="ic">₫</span> Thu nhập</a>
      <a href="/HoSo"><span class="ic">👤</span> Hồ sơ &amp; giấy tờ</a>
    </nav>

    <div class="sidebar-foot" id="sidebar-profile">
        <div class="av">@(Model.Avatar ?? "U")</div>
        <div>
            <b>@Model.FullName</b>
            <span>★ @Model.Rating.ToString("0.0") · Đã duyệt</span>
        </div>

        <div id="profile-dropdown" class="profile-dropdown hidden">
            <a href="/HoSo">⚙️ Cài đặt tài khoản</a>
            <a href="/Login" class="logout" onclick="return logoutDriver(event)">🚪 Đăng xuất</a>
        </div>
    </div>
  </aside>

  <main class="main">
    <div class="view" id="view-withdraw">

      <div class="topbar">
        <div><h1>Rút tiền</h1><p>Chuyển tiền từ ví XeGhép về tài khoản ngân hàng của bạn</p></div>
      </div>

      @if (!string.IsNullOrEmpty(Model.ErrorMessage))
      {
        <div class="alert error">⚠️ <span>@Model.ErrorMessage</span></div>
      }
      @if (!string.IsNullOrEmpty(Model.SuccessMessage))
      {
        <div class="alert success">✅ <span>@Model.SuccessMessage</span></div>
      }

      <div class="withdraw-grid">
        <!-- Cột trái: Form rút tiền -->
        <div class="card">
          <div class="balance-row">
            <div class="balance-box">
              <div class="lbl">Số dư khả dụng để rút</div>
              <div class="val">@Model.AvailableToWithdrawDisplay.ToString("N0")đ</div>
            </div>
            @if (Model.PendingWithdrawSum > 0)
            {
              <div class="balance-box pending">
                <div class="lbl">Đang chờ duyệt</div>
                <div class="val">@Model.PendingWithdrawSum.ToString("N0")đ</div>
              </div>
            }
          </div>

          <form method="post" id="withdraw-form" autocomplete="off">
            <div class="form-group">
              <label for="amount">Số tiền muốn rút</label>
              <div class="amount-input-wrap">
                <input type="number" class="form-control" id="amount" name="amount" min="@Model.MinWithdrawAmountInt"
                       step="1000" placeholder="0" value="@(Model.PostedAmount > 0 ? Model.PostedAmount.ToString("0") : "")" required>
                <span class="suffix">đ</span>
              </div>
              <div class="quick-amounts">
                <button type="button" onclick="setAmount(100000)">100.000đ</button>
                <button type="button" onclick="setAmount(500000)">500.000đ</button>
                <button type="button" onclick="setAmount(1000000)">1.000.000đ</button>
                <button type="button" onclick="setAmountMax()">Toàn bộ số dư</button>
              </div>
              <div class="hint">Số tiền rút tối thiểu: @Model.MinWithdrawAmountInt.ToString("N0")đ. Xử lý trong tối đa @Model.MaxProcessingHoursInt giờ.</div>
            </div>

            <div class="form-group">
              <label>Phương thức &amp; Tài khoản nhận tiền</label>
              <div class="bank-options" style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                <label class="bank-option">
                  <input type="radio" name="bank_choice" value="Vietcombank - 1012345678 - @Model.FullName"
                         @(Model.PostedBankChoice != "new" && Model.PostedBankChoice != "vnpay_custom" && !Model.PostedBankChoice.Contains("VNPay") ? "checked" : "")
                         onchange="handleBankChoiceChange(this.value)">
                  <div class="bi">🏦 Vietcombank (Demo) · 1012345678<small>@Model.FullName</small></div>
                </label>
                <label class="bank-option">
                  <input type="radio" name="bank_choice" value="MB Bank - 0987654321 - @Model.FullName"
                         @(Model.PostedBankChoice.Contains("MB Bank") ? "checked" : "")
                         onchange="handleBankChoiceChange(this.value)">
                  <div class="bi">🏦 MB Bank (Demo) · 0987654321<small>@Model.FullName</small></div>
                </label>
                <label class="bank-option">
                  <input type="radio" name="bank_choice" value="Ví VNPay - @(string.IsNullOrEmpty(Model.Phone) ? "0912345678" : Model.Phone) - @Model.FullName"
                         @(Model.PostedBankChoice.StartsWith("Ví VNPay -") && Model.PostedBankChoice != "vnpay_custom" ? "checked" : "")
                         onchange="handleBankChoiceChange(this.value)">
                  <div class="bi">📱 Ví VNPay (Demo) · @(string.IsNullOrEmpty(Model.Phone) ? "SĐT tài xế" : Model.Phone)<small>@Model.FullName</small></div>
                </label>
                <label class="bank-option">
                  <input type="radio" name="bank_choice" value="vnpay_custom"
                         @(Model.PostedBankChoice == "vnpay_custom" ? "checked" : "")
                         onchange="handleBankChoiceChange('vnpay_custom')">
                  <div class="bi">+ Rút về Ví VNPay khác</div>
                </label>
                <label class="bank-option" style="grid-column:span 2">
                  <input type="radio" name="bank_choice" value="new"
                         @(Model.PostedBankChoice == "new" ? "checked" : "")
                         onchange="handleBankChoiceChange('new')">
                  <div class="bi">+ Thêm tài khoản ngân hàng khác</div>
                </label>
              </div>

              <div class="new-bank-fields @(Model.PostedBankChoice == "vnpay_custom" ? "show" : "")" id="vnpay-custom-fields" style="@(Model.PostedBankChoice == "vnpay_custom" ? "" : "display:none")">
                <div class="full">
                  <input type="text" class="form-control" name="vnpay_phone" placeholder="Số điện thoại đăng ký Ví VNPay" value="@Model.PostedVnpayPhone">
                </div>
              </div>

              <div class="new-bank-fields @(Model.PostedBankChoice == "new" ? "show" : "")" id="new-bank-fields" style="@(Model.PostedBankChoice == "new" ? "" : "display:none")">
                <div class="full">
                  <input type="text" class="form-control" name="new_bank_name" placeholder="Tên ngân hàng (VD: Techcombank, BIDV, Agribank)" value="@Model.PostedNewBankName">
                </div>
                <input type="text" class="form-control" name="new_bank_number" placeholder="Số tài khoản" value="@Model.PostedNewBankNumber">
                <input type="text" class="form-control" name="new_bank_holder" placeholder="Chủ tài khoản" value="@Model.PostedNewBankHolder">
              </div>
            </div>

            <div class="form-group">
              <label for="login_password">Xác nhận bằng mật khẩu đăng nhập</label>
              <input type="password" class="form-control @(Model.PasswordError ? "input-error" : "")"
                     id="login_password" name="login_password" placeholder="••••••••" required>
            </div>

            <button type="submit" class="btn btn-primary btn-submit">💸 Xác nhận yêu cầu rút tiền</button>
            <p class="info-note">
              Yêu cầu rút tiền sẽ được gửi tới Admin để duyệt và chuyển khoản thủ công.
              Số tiền được chuyển sang trạng thái tạm giữ ngay khi gửi yêu cầu để tránh rút trùng.
              Nếu Admin từ chối, tiền sẽ tự động trở lại "Số dư khả dụng". Tiền mặt bạn đã thu trực tiếp không nằm trong ví này.
            </p>
          </form>
        </div>

        <!-- Cột phải: Lịch sử rút tiền -->
        <div class="card">
          <div class="list-title">Lịch sử rút tiền gần đây</div>
          <table class="withdraw-table">
            <thead>
              <tr><th>Thời gian</th><th>Số tiền</th><th>Tài khoản</th><th>Trạng thái</th></tr>
            </thead>
            <tbody>
              @foreach (var w in Model.RecentWithdrawals)
              {
                <tr>
                  <td>@w.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                  <td class="amount">@w.Amount.ToString("N0")đ</td>
                  <td>@w.BankInfo</td>
                  <td>@Html.Raw(XeGhepApp.Pages.RutTienModel.GetWithdrawStatusHtml(w.Status))</td>
                </tr>
              }
              @if (!Model.RecentWithdrawals.Any())
              {
                <tr class="empty-row"><td colspan="4">Chưa có yêu cầu rút tiền nào.</td></tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<script src="/assets/common.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    try {
      var sidebarProfile = document.getElementById('sidebar-profile');
      var profileDropdown = document.getElementById('profile-dropdown');
      if (sidebarProfile && profileDropdown) {
        sidebarProfile.addEventListener('click', function (e) {
          profileDropdown.classList.toggle('hidden');
          e.stopPropagation();
        });
        document.addEventListener('click', function (e) {
          if (!sidebarProfile.contains(e.target)) profileDropdown.classList.add('hidden');
        });
      }
    } catch (err) {
      console.error('Lỗi khởi tạo menu sidebar:', err);
    }
  });

  var maxAvailable = @Model.AvailableToWithdrawDisplay.ToString(System.Globalization.CultureInfo.InvariantCulture);

  function setAmount(v) {
    document.getElementById('amount').value = v;
  }
  function setAmountMax() {
    document.getElementById('amount').value = Math.floor(maxAvailable);
  }
  function handleBankChoiceChange(val) {
    var newBankFields = document.getElementById('new-bank-fields');
    var vnpayFields = document.getElementById('vnpay-custom-fields');
    if (val === 'new') {
      newBankFields.style.display = 'grid';
      newBankFields.classList.add('show');
      vnpayFields.style.display = 'none';
      vnpayFields.classList.remove('show');
    } else if (val === 'vnpay_custom') {
      vnpayFields.style.display = 'block';
      vnpayFields.classList.add('show');
      newBankFields.style.display = 'none';
      newBankFields.classList.remove('show');
    } else {
      newBankFields.style.display = 'none';
      newBankFields.classList.remove('show');
      vnpayFields.style.display = 'none';
      vnpayFields.classList.remove('show');
    }
  }
</script>
</body>
</html>
