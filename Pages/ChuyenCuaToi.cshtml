@page
@model XeGhepApp.Pages.ChuyenCuaToiModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>XeGhép — Tài xế — Chuyến của tôi</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
<script src="/auth-fetch.js"></script>
</head>
<body>
<div class="shell">
  <aside class="sidebar">
    <div class="brand"><span class="dot-route">X</span><div>XeGhép<small>TÀI XẾ</small></div></div>
    <nav class="side-nav">
      <a href="/Index"><span class="ic">🏠</span> Tổng quan</a>
      <a href="/YeuCauDatCho"><span class="ic">📥</span> Yêu cầu đặt chỗ @if(Model.PendingCount > 0){<span class="badge-count">@Model.PendingCount</span>}</a>
      <a href="/ChuyenCuaToi" class="active"><span class="ic">🧭</span> Chuyến của tôi</a>
      <a href="/ThuNhap"><span class="ic">₫</span> Thu nhập</a>
      <a href="/HoSo"><span class="ic">👤</span> Hồ sơ &amp; giấy tờ</a>
    </nav>
    <div class="sidebar-foot">
      <div class="av">@(Model.Avatar ?? "U")</div>
      <div><b>@Model.FullName</b><span>★ @Model.Rating.ToString("0.0") · Đã duyệt</span><a href="/Login" onclick="return logoutDriver(event)">🚪 Đăng xuất</a></div>
    </div>
  </aside>

  <main class="main">
    <div class="view" id="view-mytrips">
      <div class="topbar"><div><h1>Chuyến của tôi</h1><p>Quản lý các chuyến đã đăng và hành khách đã xác nhận.</p></div></div>

      <div class="tabs">
        <button class="active" data-tab="d-upcoming" onclick="switchDTab('d-upcoming')">Sắp tới @(Model.UpcomingTrips.Any() ? $"({Model.UpcomingTrips.Count})" : "")</button>
        <button data-tab="d-running" onclick="switchDTab('d-running')">Đang chạy @(Model.RunningTrips.Any() ? $"({Model.RunningTrips.Count})" : "")</button>
        <button data-tab="d-done" onclick="switchDTab('d-done')">Hoàn thành</button>
      </div>

      <div id="dtab-d-upcoming">
        @if (!Model.UpcomingTrips.Any()) {
          <p style="font-size:13.5px;color:var(--ink-soft)">Không có chuyến nào sắp khởi hành.</p>
        }
        @foreach (var trip in Model.UpcomingTrips) {
        <div class="trip-manage-card" data-trip-id="@trip.TripId">
          <div class="top"><span class="status-pill upcoming">Sắp khởi hành</span><span class="mono" style="font-size:12.5px;color:var(--ink-faint)">@trip.DepartureTime.ToString("HH:mm") · @trip.DepartureTime.ToString("dd/MM/yyyy")</span></div>
          <div class="route-strip">
            <div class="pt"><div class="city">@trip.RouteFrom</div><div class="sub">@trip.PickupLocation</div></div>
            <div class="route-line"><div class="node start"></div><span class="van">🚐</span><div class="node end"></div></div>
            <div class="pt end"><div class="city">@trip.RouteTo</div><div class="sub">@trip.DropoffLocation</div></div>
          </div>
          <div class="pax-list">
            @foreach (var p in trip.Pax) {
              <div class="pax-chip" data-booking-id="@p.BookingId"><span class="av">@(p.Avatar ?? p.FullName.Split(' ').LastOrDefault()?.Substring(0, 1))</span> @(p.FullName.Split(' ').LastOrDefault()) · @p.Seats ghế <span class="sub">Đón: @p.PickupAddress · Trả: @p.DropoffAddress</span>
                @if (p.PaymentMethod == "cash" && p.PaymentStatus != "paid") {
                  <button class="btn btn-outline btn-sm" onclick="confirmCash(this)">Xác nhận tiền mặt</button>
                }
              </div>
            }
            @if (!trip.Pax.Any()) {
              <span style="font-size:12.5px;color:var(--ink-faint);">Chưa có hành khách đặt chỗ</span>
            }
          </div>
          <div class="bottom">
            <span style="font-size:12.5px;color:var(--ink-soft)">@trip.SeatsBooked/@trip.TotalSeats ghế đã đặt</span>
            <div style="display:flex;gap:6px"><button class="btn btn-outline btn-sm" onclick="showCancelTrip(this)">Xin hủy/đổi tài xế</button><button class="btn btn-green btn-sm" onclick="startTrip(this)">Bắt đầu chuyến</button></div>
          </div>
          <div class="cancel-trip-form hidden" style="margin-top:10px"><input maxlength="500" placeholder="Nhập lý do xin hủy chuyến" style="width:100%;padding:9px"><button class="btn btn-coral btn-sm" style="margin-top:6px" onclick="requestTripCancellation(this)">Gửi yêu cầu</button></div>
        </div>
        }
      </div>

      <div id="dtab-d-running" class="hidden">
        @if (!Model.RunningTrips.Any()) {
          <p style="font-size:13.5px;color:var(--ink-soft)">Hiện không có chuyến nào đang chạy.</p>
        }
        @foreach (var trip in Model.RunningTrips) {
        <div class="trip-manage-card" data-trip-id="@trip.TripId">
          <div class="top"><span class="status-pill running">Đang di chuyển</span><span class="mono" style="font-size:12.5px;color:var(--ink-faint)">Khởi hành @trip.DepartureTime.ToString("HH:mm")</span></div>
          <div class="route-strip">
            <div class="pt"><div class="city">@trip.RouteFrom</div><div class="sub">@trip.PickupLocation</div></div>
            <div class="route-line"><div class="node start"></div><span class="van">🚐</span><div class="node end"></div></div>
            <div class="pt end"><div class="city">@trip.RouteTo</div><div class="sub">@trip.DropoffLocation</div></div>
          </div>
          <div class="pax-list">
            @foreach (var p in trip.Pax) {
              <div class="pax-chip"><span class="av">@(p.Avatar ?? p.FullName.Split(' ').LastOrDefault()?.Substring(0, 1))</span> @(p.FullName.Split(' ').LastOrDefault()) · @p.Seats ghế <span class="sub">Đón: @p.PickupAddress · Trả: @p.DropoffAddress</span></div>
            }
            @if (!trip.Pax.Any()) {
              <span style="font-size:12.5px;color:var(--ink-faint);">Không có hành khách</span>
            }
          </div>
          <div class="bottom">
            <span style="font-size:12.5px;color:var(--ink-soft)">@trip.RouteTo · @trip.PricePerSeat.ToString("N0")đ/ghế</span>
            <button class="btn btn-primary btn-sm" onclick="completeTrip(this)">Hoàn thành chuyến</button>
          </div>
        </div>
        }
      </div>

      <div id="dtab-d-done" class="hidden">
        @if (!Model.DoneTrips.Any()) {
          <p style="font-size:13.5px;color:var(--ink-soft)">Chưa có chuyến nào hoàn thành.</p>
        }
        @foreach (var trip in Model.DoneTrips) {
        <div class="trip-manage-card" data-trip-id="@trip.TripId">
          <div class="top"><span class="status-pill done">Hoàn thành</span><span class="mono" style="font-size:12.5px;color:var(--ink-faint)">@trip.DepartureTime.ToString("dd/MM/yyyy")</span></div>
          <div class="route-strip">
            <div class="pt"><div class="city">@trip.RouteFrom</div><div class="sub">@trip.DepartureTime.ToString("HH:mm")</div></div>
            <div class="route-line"><div class="node start"></div><div class="node end"></div></div>
            <div class="pt end"><div class="city">@trip.RouteTo</div><div class="sub">&nbsp;</div></div>
          </div>
          <div class="pax-list">
            @foreach (var p in trip.Pax) {
              <div class="pax-chip" data-booking-id="@p.BookingId">
                <span class="av">@(p.Avatar ?? p.FullName.Split(' ').LastOrDefault()?.Substring(0, 1))</span> @(p.FullName.Split(' ').LastOrDefault())
                @if (p.ReviewedByDriver) {
                  <span class="doc-status approved">Đã đánh giá</span>
                } else {
                  <button class="btn btn-outline btn-sm" onclick="showReview(this)">Đánh giá</button>
                  <span class="review-form hidden" style="width:100%">
                    <select aria-label="Số sao">
                      <option value="5">5 sao</option>
                      <option value="4">4 sao</option>
                      <option value="3">3 sao</option>
                      <option value="2">2 sao</option>
                      <option value="1">1 sao</option>
                    </select>
                    <input maxlength="500" placeholder="Nhận xét (không bắt buộc)">
                    <button class="btn btn-primary btn-sm" onclick="submitReview(this)">Gửi</button>
                  </span>
                }
                <button class="btn btn-coral btn-sm" onclick="showPassengerComplaint(this)">Khiếu nại</button>
                <span class="complaint-form hidden" style="width:100%"><input class="complaint-content" maxlength="2000" placeholder="Nội dung khiếu nại"><input class="complaint-file" type="file" accept="image/jpeg,image/png,application/pdf"><button class="btn btn-coral btn-sm" onclick="submitPassengerComplaint(this)">Gửi</button></span>
              </div>
            }
          </div>
          <div class="bottom">
            <span style="font-size:12.5px;color:var(--ink-soft)">Thu nhập: @(Model.DoneIncome.ContainsKey(trip.TripId) ? Model.DoneIncome[trip.TripId].ToString("N0") : "0")đ</span>
          </div>
        </div>
        }
      </div>
      <div class="card" style="margin-top:16px">
        <b>Khiếu nại đã gửi</b>
        <div id="complaint-history" style="margin-top:8px;color:var(--ink-soft);font-size:13px">Đang tải…</div>
      </div>
    </div>
  </main>
</div>

<script src="assets/common.js"></script>
<script>
  function switchDTab(tab){
    ['d-upcoming','d-running','d-done'].forEach(t => document.getElementById('dtab-'+t).classList.toggle('hidden', t !== tab));
    document.querySelectorAll('.tabs button').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
  }

  function startTrip(btn){
    const card = btn.closest('.trip-manage-card');
    const tripId = card.dataset.tripId;

    btn.disabled = true;
    const originalText = btn.textContent;
    btn.textContent = 'Đang xử lý…';

    fetch('start-trip.php', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ trip_id: tripId })
    })
      .then(res => res.json())
      .then(data => {
        if (!data.ok) {
          showToast(data.message || 'Không thể bắt đầu chuyến.', 'error');
          btn.disabled = false;
          btn.textContent = originalText;
          return;
        }
        location.reload();
      })
      .catch(() => {
        showToast('Lỗi kết nối, vui lòng thử lại.', 'error');
        btn.disabled = false;
        btn.textContent = originalText;
      });
  }

  function confirmCash(btn){
    const chip = btn.closest('.pax-chip');
    btn.disabled = true;
    fetch('/api/driver/bookings/' + chip.dataset.bookingId + '/confirm-cash', { method: 'POST' })
      .then(res => res.json().then(data => ({ ok: res.ok, data })))
      .then(result => { if (!result.ok) throw new Error(result.data.message || 'Không thể xác nhận tiền mặt.'); btn.textContent = 'Đã nhận tiền'; })
      .catch(err => { showToast(err.message, 'error'); btn.disabled = false; });
  }

  function showCancelTrip(btn){
    btn.closest('.trip-manage-card').querySelector('.cancel-trip-form').classList.remove('hidden');
  }

  function requestTripCancellation(btn){
    const card = btn.closest('.trip-manage-card');
    const reason = card.querySelector('.cancel-trip-form input').value.trim();
    if (!reason) { showToast('Vui lòng nhập lý do.', 'error'); return; }
    btn.disabled = true;
    fetch('/api/driver/trips/' + card.dataset.tripId + '/cancel-request', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reason })
    }).then(res => res.json().then(data => ({ ok: res.ok, data })))
      .then(result => { if (!result.ok) throw new Error(result.data.message || 'Không thể gửi yêu cầu.'); location.reload(); })
      .catch(err => { showToast(err.message, 'error'); btn.disabled = false; });
  }

  function showReview(btn){
    btn.classList.add('hidden');
    btn.closest('.pax-chip').querySelector('.review-form').classList.remove('hidden');
  }

  function submitReview(btn){
    const chip = btn.closest('.pax-chip');
    const form = btn.closest('.review-form');
    btn.disabled = true;
    fetch('/api/driver/bookings/' + chip.dataset.bookingId + '/review', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ rating: Number(form.querySelector('select').value), comment: form.querySelector('input').value })
    }).then(res => res.json().then(data => ({ ok: res.ok, data })))
      .then(result => { if (!result.ok) throw new Error(result.data.message || 'Không thể gửi đánh giá.'); form.innerHTML = '<span class="doc-status approved">Đã đánh giá</span>'; })
      .catch(err => { showToast(err.message, 'error'); btn.disabled = false; });
  }

  function showPassengerComplaint(btn){
    btn.closest('.pax-chip').querySelector('.complaint-form').classList.remove('hidden');
  }

  async function submitPassengerComplaint(btn){
    const chip = btn.closest('.pax-chip');
    const form = btn.closest('.complaint-form');
    const content = form.querySelector('.complaint-content').value.trim();
    const file = form.querySelector('.complaint-file').files[0];
    if(!content){ showToast('Vui lòng nhập nội dung khiếu nại.', 'error'); return; }
    btn.disabled = true;
    try {
      const res = await fetch('/api/driver/bookings/' + chip.dataset.bookingId + '/complaints', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ content })
      });
      const data = await res.json();
      if(!res.ok) throw new Error(data.message || 'Không thể gửi khiếu nại.');
      if(file){
        const fd = new FormData(); fd.append('file', file);
        const upload = await fetch('/api/driver/complaints/' + data.complaint_id + '/attachments', { method:'POST', body:fd });
        const uploadData = await upload.json();
        if(!upload.ok) throw new Error('Khiếu nại đã tạo nhưng chưa lưu được bằng chứng: ' + (uploadData.message || 'Lỗi tải file.'));
      }
      form.innerHTML = '<span class="doc-status approved">Đã gửi khiếu nại</span>';
      loadComplaintHistory();
    } catch(err) { showToast(err.message, 'error'); btn.disabled = false; }
  }

  function loadComplaintHistory(){
    const container = document.getElementById('complaint-history');
    fetch('/api/driver/complaints/mine')
      .then(res => { if(!res.ok) throw new Error(); return res.json(); })
      .then(items => {
        container.textContent = '';
        if(!items.length){ container.textContent = 'Chưa có khiếu nại.'; return; }
        items.forEach(item => {
          const line = document.createElement('div');
          line.style.marginBottom = '6px';
          line.textContent = `${item.complaint_id} · Chuyến ${item.trip_id} · ${item.status}${item.resolution_note ? ' · ' + item.resolution_note : ''}`;
          container.appendChild(line);
        });
      })
      .catch(() => { container.textContent = 'Không tải được lịch sử khiếu nại.'; });
  }

  loadComplaintHistory();

  function completeTrip(btn){
    const card = btn.closest('.trip-manage-card');
    const tripId = card.dataset.tripId;

    askConfirm('Xác nhận đã hoàn thành chuyến đi ' + tripId + '?\nSố tiền chuyến này sẽ được cộng vào thu nhập của bạn.').then(confirmed => {
      if (!confirmed) return;

      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = 'Đang xử lý…';

      fetch('complete-trip.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ trip_id: tripId })
      })
        .then(res => res.json())
        .then(data => {
          if (!data.ok) {
            showToast(data.message || 'Không thể hoàn thành chuyến.', 'error');
            btn.disabled = false;
            btn.textContent = originalText;
            return;
          }
          location.reload();
        })
        .catch(() => {
          showToast('Lỗi kết nối, vui lòng thử lại.', 'error');
          btn.disabled = false;
          btn.textContent = originalText;
        });
    });
  }

</script>
</body>
</html>
