@page
@model XeGhepApp.Pages.DangKyModel
@{
    Layout = null;
}

<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>XeGhép — Đăng ký tài xế</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        body {
            margin: 0;
            background: #f5f6f8;
            font-family: Inter, Arial, sans-serif;
        }

        .auth-shell {
            min-height: 100vh;
            padding: 30px 18px;
        }

        .card {
            max-width: 720px;
            margin: auto;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 10px 28px rgba(0, 0, 0, .06);
        }

        h1 {
            font-size: 23px;
            margin: 0 0 6px;
        }

        .sub {
            color: #6b7280;
            margin: 0 0 24px;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .field label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .field input {
            width: 100%;
            box-sizing: border-box;
            padding: 10px;
            border: 1px solid #d1d5db;
            border-radius: 9px;
        }

        .wide {
            grid-column: 1 / -1;
        }

        .section {
            grid-column: 1 / -1;
            font-weight: 800;
            border-bottom: 1px solid #e5e7eb;
            padding: 10px 0 6px;
        }

        .btn {
            width: 100%;
            padding: 12px;
            border: 0;
            border-radius: 9px;
            background: #2563eb;
            color: white;
            font-weight: 700;
            margin-top: 20px;
        }

        .alert {
            padding: 11px;
            border-radius: 8px;
            margin-bottom: 16px;
        }

        .error {
            background: #fef2f2;
            color: #b91c1c;
        }

        .success {
            background: #f0fdf4;
            color: #15803d;
        }

        .otp {
            display: none;
            text-align: center;
        }

        .otp input {
            width: 180px;
            font-size: 24px;
            letter-spacing: 12px;
            text-align: center;
            padding: 12px;
        }

        .foot {
            text-align: center;
            margin-top: 18px;
        }

        @@media(max-width: 650px) {
            .grid {
                grid-template-columns: 1fr;
            }

            .wide,
            .section {
                grid-column: auto;
            }
        }
    </style>
</head>
<body>
    <main class="auth-shell">
        <section class="card">
            <h1>Đăng ký đối tác tài xế</h1>
            <p class="sub">Nhập đủ thông tin và 9 giấy tờ bắt buộc để Admin xét duyệt.</p>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert error">@Model.ErrorMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
            {
                <div class="alert success">@Model.SuccessMessage</div>
                <div class="foot"><a href="/Login">Đến trang đăng nhập</a></div>
            }
            else
            {
                <form id="register-form" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="reg_role" value="driver">

                    <div class="grid">
                        <div class="section">Thông tin cá nhân</div>
                        <div class="field">
                            <label>Họ và tên</label>
                            <input name="full_name" required>
                        </div>
                        <div class="field">
                            <label>Số điện thoại</label>
                            <input id="driver_phone" name="driver_phone" inputmode="tel" required>
                        </div>
                        <div class="field">
                            <label>Email</label>
                            <input name="driver_email" type="email">
                        </div>
                        <div class="field">
                            <label>Mật khẩu</label>
                            <input name="password" type="password" minlength="8" required>
                        </div>

                        <div class="section">Xe và giấy tờ</div>
                        <div class="field">
                            <label>Loại xe</label>
                            <input name="vehicle_type" required>
                        </div>
                        <div class="field">
                            <label>Biển số</label>
                            <input name="license_plate" required>
                        </div>
                        <div class="field">
                            <label>Số ghế phục vụ</label>
                            <input name="seat_count" type="number" min="1" max="16" value="4" required>
                        </div>
                        <div class="field">
                            <label>Khu vực hoạt động</label>
                            <input name="operation_area" placeholder="Ví dụ: Hà Nội, Ninh Bình" required>
                        </div>

                        @foreach (var doc in new[]
                        {
                            ("portrait", "Ảnh chân dung"),
                            ("cccd_front", "CCCD mặt trước"),
                            ("cccd_back", "CCCD mặt sau"),
                            ("gplx", "Giấy phép lái xe"),
                            ("lltp", "Lý lịch tư pháp"),
                            ("gksk", "Giấy khám sức khỏe"),
                            ("cavet", "Đăng ký xe"),
                            ("baohiem", "Bảo hiểm TNDS"),
                            ("hinhxe", "Ảnh thực tế xe")
                        })
                        {
                            <div class="field">
                                <label>@doc.Item2</label>
                                <input type="file"
                                       name="@doc.Item1"
                                       accept="image/jpeg,image/png,application/pdf"
                                       required>
                            </div>
                        }
                    </div>

                    <button class="btn" type="button" onclick="sendOtp()">Nhận mã OTP</button>
                </form>

                <div id="otp" class="otp">
                    <h2>Xác thực số điện thoại</h2>
                    <p>Mã có hiệu lực 90 giây.</p>
                    <div id="debug" class="alert success" style="display:none"></div>
                    <input id="otp-code" maxlength="6" inputmode="numeric">
                    <button class="btn" type="button" onclick="verifyOtp()">Xác nhận và hoàn tất</button>
                    <button class="btn"
                            type="button"
                            style="background:#64748b"
                            onclick="sendOtp()">
                        Gửi lại OTP
                    </button>
                    <div id="otp-error" class="alert error" style="display:none;margin-top:12px"></div>
                </div>

                <div class="foot">Đã có tài khoản? <a href="/Login">Đăng nhập</a></div>
            }
        </section>
    </main>

    <script>
        const form = document.getElementById('register-form');

        function token(formData) {
            const antiForgeryToken = document.querySelector('[name="__RequestVerificationToken"]');
            if (antiForgeryToken) {
                formData.append('__RequestVerificationToken', antiForgeryToken.value);
            }
        }

        async function sendOtp() {
            if (!form.reportValidity()) {
                return;
            }

            const formData = new FormData();
            formData.append('ajax_action', 'send_otp');
            formData.append('otp_target', document.getElementById('driver_phone').value);
            formData.append('reg_role', 'driver');
            token(formData);

            const response = await fetch('', {
                method: 'POST',
                body: formData
            });
            const data = await response.json();

            if (!data.success) {
                showError(data.message);
                return;
            }

            form.style.display = 'none';
            document.getElementById('otp').style.display = 'block';

            if (data.debug_code) {
                const debug = document.getElementById('debug');
                debug.textContent = 'Mã OTP demo: ' + data.debug_code;
                debug.style.display = 'block';
            }
        }

        async function verifyOtp() {
            const formData = new FormData();
            formData.append('ajax_action', 'verify_otp');
            formData.append('otp_code', document.getElementById('otp-code').value);
            token(formData);

            const response = await fetch('', {
                method: 'POST',
                body: formData
            });
            const data = await response.json();

            if (!data.success) {
                showError(data.message);
                return;
            }

            form.submit();
        }

        function showError(message) {
            const error = document.getElementById('otp-error');
            error.textContent = message || 'Không thể xử lý OTP.';
            error.style.display = 'block';
        }
    </script>
</body>
</html>
