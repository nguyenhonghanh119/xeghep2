@{
    Layout = null;
    string result = ViewBag.Result ?? "failed";
    string color = result == "success" ? "#1a7f37" : "#d1242f";
    string title = result switch
    {
        "success" => "Thanh toán thành công",
        "invalid" => "Chữ ký không hợp lệ",
        _ => "Thanh toán không thành công",
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kết quả thanh toán VNPay</title>
<link rel="stylesheet" href="~/style.css">
</head>
<body style="padding:40px;font-family:Inter,sans-serif;max-width:560px;margin:0 auto">
  <h2 style="color:@color">@title</h2>
  <p>@ViewBag.Message</p>
  <table style="width:100%;border-collapse:collapse;margin-top:16px">
    <tr><td style="padding:6px 0;color:#666">Mã đơn hàng</td><td style="text-align:right"><b>@ViewBag.TxnRef</b></td></tr>
    <tr><td style="padding:6px 0;color:#666">Số tiền</td><td style="text-align:right">@(ViewBag.Amount != null ? (Convert.ToInt64(ViewBag.Amount) / 100).ToString("N0") + "đ" : "-")</td></tr>
    <tr><td style="padding:6px 0;color:#666">Nội dung</td><td style="text-align:right">@ViewBag.OrderInfo</td></tr>
    <tr><td style="padding:6px 0;color:#666">Mã GD tại VNPay</td><td style="text-align:right">@ViewBag.TransNo</td></tr>
    <tr><td style="padding:6px 0;color:#666">Ngân hàng</td><td style="text-align:right">@ViewBag.BankCode</td></tr>
    <tr><td style="padding:6px 0;color:#666">Thời gian</td><td style="text-align:right">@ViewBag.PayDate</td></tr>
  </table>
  <a href="/khach-chuyen-cua-toi" style="display:inline-block;margin-top:24px;padding:10px 18px;background:#0a2540;color:#fff;border-radius:8px;text-decoration:none">Xem chuyến của tôi</a>
</body>
</html>
