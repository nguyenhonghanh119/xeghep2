@model List<VnPayXeGhep.Models.TripSearchResult>
@{
    Layout = null;
    string from = ViewBag.From ?? "Hà Nội";
    string? to = ViewBag.To;
    string date = ViewBag.Date;
    int seats = ViewBag.Seats ?? 1;
    int badge = ViewBag.MyTripsBadge ?? 0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>XeGhép — Hành khách — Tìm chuyến</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/style.css">
</head>
<body>
<div class="shell">
  <aside class="sidebar">
    <div class="brand"><span class="dot-route">X</span><div>XeGhép<small>HÀNH KHÁCH</small></div></div>
    <nav class="side-nav">
      <a href="/khach-index" class="active"><span class="ic">🔍</span> Tìm chuyến</a>
      <a href="/khach-chuyen-cua-toi"><span class="ic">🧭</span> Chuyến của tôi <span class="badge-count">@badge</span></a>
      <a href="/khach-ho-so"><span class="ic">👤</span> Hồ sơ &amp; Thanh toán</a>
    </nav>
    <div class="sidebar-foot"><div class="av">L</div><div><b>Nguyễn Thị Lan</b><span>091 888 2233</span><span class="role-pill">Đã xác thực</span></div></div>
  </aside>

  <main class="main">
    <div class="view" id="view-search">
      <div class="topbar"><div><h1>Bạn muốn đi đâu hôm nay? 👋</h1><p>Tìm chuyến ghép phù hợp với lịch trình của bạn.</p></div></div>

      <div class="card">
        <form id="search-form" class="form-grid" method="get" action="/khach-index">
          <div class="field"><label>Điểm đón</label><div class="input">📍<input name="from" placeholder="VD: Hà Nội" value="@from" required></div></div>
          <div class="field"><label>Điểm đến</label><div class="input">🏁<input name="to" placeholder="VD: Ninh Bình" value="@to"></div></div>
          <div class="field"><label>Ngày đi</label><div class="input">📅<input type="date" name="date" value="@date"></div></div>
          <div class="field">
            <label>Số ghế</label>
            <div class="qty-stepper">
              <button type="button" onclick="changeSeats(-1)">−</button>
              <span id="seat-count">@seats</span>
              <button type="button" onclick="changeSeats(1)">+</button>
              <input type="hidden" name="seats" id="seat-count-input" value="@seats">
            </div>
          </div>
          <button type="submit" class="btn btn-primary full" style="margin-top:4px;padding:12px 20px;justify-self:start">🔍 Tìm chuyến</button>
        </form>
      </div>

      <div class="list-title" style="margin-top:24px">Chuyến phù hợp (<span id="result-count">@Model.Count</span>)</div>
      <div id="search-results">
        @if (!Model.Any())
        {
            <div class="card"><p style="color:var(--ink-faint);text-align:center;padding:24px 0">Không tìm thấy chuyến phù hợp. Hãy thử đổi điểm đến hoặc ngày đi.</p></div>
        }
        @foreach (var t in Model)
        {
            <div class="card">
              <div class="top" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                <span class="mono" style="font-size:12.5px;color:var(--ink-faint)">@t.DepartureTime.ToString("HH:mm") · @t.DepartureTime.ToString("dd/MM/yyyy")</span>
                <span class="mono" style="font-weight:700;color:var(--navy)">@t.PricePerSeat.ToString("N0")đ/ghế</span>
              </div>
              <div class="route-strip" style="margin-bottom:14px">
                <div class="pt"><div class="city">@t.RouteFrom</div><div class="sub">@t.PickupLocation</div></div>
                <div class="route-line"><div class="node start"></div><span class="van">🚐</span><div class="node end"></div></div>
                <div class="pt end"><div class="city">@t.RouteTo</div><div class="sub">@t.DropoffLocation</div></div>
              </div>
              <div class="bottom" style="display:flex;justify-content:space-between;align-items:center">
                <span style="font-size:13px;color:var(--ink-soft)">🚐 @t.VehicleType · @t.DriverName · ★ @t.DriverRating.ToString("0.0") · Còn @t.AvailableSeats ghế</span>
                <a class="btn btn-primary btn-sm" href="/khach-dat-cho?trip=@t.TripId">Đặt chỗ</a>
              </div>
            </div>
        }
      </div>
    </div>
  </main>
</div>

<script src="~/assets/common.js"></script>
<script>
  let seats = @seats;
  function changeSeats(delta){
    seats = Math.max(1, Math.min(8, seats + delta));
    document.getElementById('seat-count').textContent = seats;
    document.getElementById('seat-count-input').value = seats;
  }
</script>
</body>
</html>
