@model List<VnPayXeGhep.Models.MyBookingItem>
@{
    Layout = null;
    int badge = ViewBag.MyTripsBadge ?? 0;

    string StatusLabel(VnPayXeGhep.Models.MyBookingItem b) => b.Tab switch
    {
        "k-upcoming" => "Sắp khởi hành",
        "k-running" => "Đang di chuyển",
        "k-done" => "Hoàn thành",
        _ => "Đã huỷ",
    };
    string StatusClass(VnPayXeGhep.Models.MyBookingItem b) => b.Tab switch
    {
        "k-upcoming" => "upcoming",
        "k-running" => "running",
        "k-done" => "done",
        _ => "cancelled",
    };

    var groups = Model.GroupBy(b => b.Tab).ToDictionary(g => g.Key, g => g.ToList());
    List<VnPayXeGhep.Models.MyBookingItem> Get(string tab) => groups.TryGetValue(tab, out var l) ? l : new();
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>XeGhép — Hành khách — Chuyến của tôi</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/style.css">
</head>
<body>
<div class="shell">
  <aside class="sidebar">
    <div class="brand"><span class="dot-route">X</span><div>XeGhép<small>HÀNH KHÁCH</small></div></div>
    <nav class="side-nav">
      <a href="/khach-index"><span class="ic">🔍</span> Tìm chuyến</a>
      <a href="/khach-chuyen-cua-toi" class="active"><span class="ic">🧭</span> Chuyến của tôi <span class="badge-count">@badge</span></a>
      <a href="/khach-ho-so"><span class="ic">👤</span> Hồ sơ &amp; Thanh toán</a>
    </nav>
    <div class="sidebar-foot"><div class="av">L</div><div><b>Nguyễn Thị Lan</b><span>091 888 2233</span><span class="role-pill">Đã xác thực</span></div></div>
  </aside>

  <main class="main">
    <div class="view" id="view-mybookings">
      <div class="topbar"><div><h1>Chuyến của tôi</h1><p>Quản lý các chuyến đã đặt và trạng thái thanh toán.</p></div></div>

      <div class="tabs">
        <button class="active" data-tab="k-upcoming" onclick="switchKTab('k-upcoming')">Sắp tới</button>
        <button data-tab="k-running" onclick="switchKTab('k-running')">Đang đi</button>
        <button data-tab="k-done" onclick="switchKTab('k-done')">Hoàn thành</button>
        <button data-tab="k-cancelled" onclick="switchKTab('k-cancelled')">Đã huỷ</button>
      </div>

      @foreach (var tab in new[] { "k-upcoming", "k-running", "k-done", "k-cancelled" })
      {
          var list = Get(tab);
          <div id="ktab-@tab" class="@(tab == "k-upcoming" ? "" : "hidden")">
            @if (!list.Any())
            {
                <div class="card"><p style="color:var(--ink-faint);text-align:center;padding:20px 0">Không có chuyến nào.</p></div>
            }
            @foreach (var b in list)
            {
                <div class="trip-manage-card" data-booking-id="@b.BookingId" data-trip-id="@b.TripId" style="@(b.Tab == "k-cancelled" ? "opacity:.65" : "")">
                  <div class="top"><span class="status-pill @StatusClass(b)">@StatusLabel(b)</span><span class="mono" style="font-size:12.5px;color:var(--ink-faint)">@b.DepartureTime.ToString("HH:mm") · @b.DepartureTime.ToString("dd/MM/yyyy")</span></div>
                  <div class="route-strip">
                    <div class="pt"><div class="city">@b.RouteFrom</div><div class="sub">@b.PickupLocation</div></div>
                    <div class="route-line"><div class="node start"></div><span class="van">🚐</span><div class="node end"></div></div>
                    <div class="pt end"><div class="city">@b.RouteTo</div><div class="sub">@b.DropoffLocation</div></div>
                  </div>
                  <div class="pax-list"><div class="pax-chip"><span class="av">@(b.DriverName.Length > 0 ? b.DriverName[0].ToString() : "?")</span> Tài xế: @b.DriverName · ★@b.DriverRating.ToString("0.0")</div></div>
                  <div class="bottom">
                    <span style="font-size:12.5px;color:var(--ink-soft)">@b.Seats ghế · @b.TotalAmount.ToString("N0")đ ·
                      @if (b.PaymentMethod == "online")
                      {
                          <span class="method-tag online">@(b.PaymentStatus == "paid" ? "Đã thanh toán online" : "Chờ thanh toán online")</span>
                      }
                      else
                      {
                          <span class="method-tag cash">Thanh toán tiền mặt khi lên xe</span>
                      }
                    </span>
                    @if (b.Tab == "k-upcoming")
                    {
                        <button class="btn btn-coral btn-sm" onclick="cancelBooking(this)">Huỷ chuyến</button>
                    }
                    else if (b.Tab == "k-done" && !b.AlreadyReviewed)
                    {
                        <button class="btn btn-outline btn-sm" onclick="reviewBooking(this)">★ Đánh giá tài xế</button>
                    }
                    else if (b.Tab == "k-done" && b.AlreadyReviewed)
                    {
                        <span style="font-size:12.5px;color:var(--ink-faint)">Đã đánh giá</span>
                    }
                  </div>
                </div>
            }
          </div>
      }
    </div>
  </main>
</div>

<script src="~/assets/common.js"></script>
<script>
  function switchKTab(tab){
    ['k-upcoming','k-running','k-done','k-cancelled'].forEach(t => document.getElementById('ktab-'+t).classList.toggle('hidden', t !== tab));
    document.querySelectorAll('.tabs button').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
  }

  async function cancelBooking(btn){
    const card = btn.closest('.trip-manage-card');
    const id = card.dataset.bookingId;
    if(!confirm('Bạn có chắc muốn huỷ chuyến này?')) return;
    try {
      const res = await apiFetch(`/api/passenger/bookings/${id}/cancel`, { method: 'POST' });
      alert(res.message);
      window.location.reload();
    } catch (err) {
      alert(err.message);
    }
  }

  async function reviewBooking(btn){
    const card = btn.closest('.trip-manage-card');
    const tripId = card.dataset.tripId;
    const ratingStr = prompt('Đánh giá tài xế (1-5 sao):', '5');
    if (!ratingStr) return;
    const rating = parseInt(ratingStr, 10);
    if (!rating || rating < 1 || rating > 5) { alert('Vui lòng nhập số sao từ 1 đến 5.'); return; }
    const comment = prompt('Nhận xét (không bắt buộc):', '') || '';
    try {
      const res = await apiFetch(`/api/passenger/bookings/${tripId}/review`, {
        method: 'POST',
        body: JSON.stringify({ rating, comment })
      });
      alert(res.message);
      window.location.reload();
    } catch (err) {
      alert(err.message);
    }
  }
</script>
</body>
</html>
