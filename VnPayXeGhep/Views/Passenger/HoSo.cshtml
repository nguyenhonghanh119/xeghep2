@model VnPayXeGhep.Models.ProfileViewModel
@{
    Layout = null;
    int badge = ViewBag.MyTripsBadge ?? 0;
    var txs = (List<VnPayXeGhep.Models.TransactionHistoryItem>)ViewBag.Transactions;
    var withdrawals = (List<VnPayXeGhep.Models.WithdrawalHistoryItem>)ViewBag.Withdrawals;

    string StatusLabel(string s) => s switch
    {
        "approved" => "Thành công",
        "pending_cash_audit" => "Đã thanh toán tài xế",
        "refunded" => "Đã hoàn tiền",
        "cancelled" => "Đã huỷ",
        _ => s,
    };
    string StatusClass(string s) => s switch
    {
        "approved" => "approved",
        "refunded" or "cancelled" => "cancelled",
        _ => "approved",
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>XeGhép — Hành khách — Hồ sơ &amp; Thanh toán</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/style.css">
</head>
<body>
<div class="shell">
  <aside class="sidebar">
    <div class="brand"><span class="dot-route">X</span><div>XeGhép<small>HÀNH KHÁCH</small></div></div>
    <nav class="side-nav">
      <a href="/khach-index"><span class="ic">🔍</span> Tìm chuyến</a>
      <a href="/khach-chuyen-cua-toi"><span class="ic">🧭</span> Chuyến của tôi <span class="badge-count">@badge</span></a>
      <a href="/khach-ho-so" class="active"><span class="ic">👤</span> Hồ sơ &amp; Thanh toán</a>
    </nav>
    <div class="sidebar-foot"><div class="av">@Model.InitialLetter</div><div><b>@Model.FullName</b><span>@Model.Phone</span><span class="role-pill">@(Model.PhoneVerified ? "Đã xác thực" : "Chưa xác thực")</span></div></div>
  </aside>

  <main class="main">
    <div class="view" id="view-profile">
      <div class="topbar"><div><h1>Hồ sơ &amp; Thanh toán</h1><p>Thông tin cá nhân và lịch sử giao dịch.</p></div></div>

      <div class="profile-layout">
        <div class="card" style="text-align:center">
          <div class="av-xl">@Model.InitialLetter</div>
          <h3 style="font-size:16px">@Model.FullName</h3>
          <p style="font-size:12px;color:var(--ink-faint);margin-top:2px">Hành khách từ @Model.JoinedYear</p>
          <div style="margin-top:10px"><span class="doc-status approved">@(Model.PhoneVerified ? "Đã xác thực SĐT" : "Chưa xác thực SĐT")</span></div>
        </div>

        <div>
          <div class="card">
            <div class="list-title">Thông tin cá nhân</div>
            <form id="profile-form" class="form-grid" onsubmit="return saveProfile(event)" novalidate>
              <div class="field"><label>Họ và tên</label><div class="input"><input name="fullName" value="@Model.FullName"></div></div>
              <div class="field"><label>Số điện thoại</label><div class="input"><input name="phone" value="@Model.Phone"></div></div>
              <div class="field full">
                <label>Email</label>
                <div class="input"><input type="email" id="profile-email" name="email" value="@Model.Email"></div>
                <small id="profile-email-error" style="color:#dc2626;display:none;margin-top:4px"></small>
              </div>
              <button type="submit" class="btn btn-primary full" style="margin-top:16px;padding:11px 20px;justify-self:start">Lưu thay đổi</button>
            </form>
          </div>

          <div class="card">
            <div class="list-title">Ví của tôi</div>
            <div class="summary-box" style="margin-bottom:14px">
              <div class="summary-row total"><span>Số dư khả dụng</span><span class="mono" id="wallet-balance">@Model.WalletBalance.ToString("N0")đ</span></div>
            </div>
            <p style="font-size:12px;color:var(--ink-faint);margin:0 0 12px">Tiền hoàn từ các chuyến đã huỷ (thanh toán online) sẽ tự động cộng vào đây. Bạn có thể rút thẳng về tài khoản ngân hàng bất cứ lúc nào.</p>
            <form id="withdraw-form" class="form-grid" onsubmit="return withdrawWallet(event)" novalidate>
              <div class="field">
                <label>Số tiền muốn rút (đ)</label>
                <div class="input">
                  <input type="number" id="withdraw-amount" name="amount" placeholder="VD: 100000" style="width:100%">
                </div>
                <small id="withdraw-amount-error" style="color:#dc2626;display:none;margin-top:4px"></small>
              </div>
              <div class="field">
                <label>Ngân hàng nhận tiền</label>
                <div class="input"><input id="withdraw-bank" name="bankName" placeholder="VD: Vietcombank"></div>
                <small id="withdraw-bank-error" style="color:#dc2626;display:none;margin-top:4px"></small>
              </div>
              <div class="field full">
                <label>Số tài khoản</label>
                <div class="input"><input id="withdraw-account" name="accountNumber" placeholder="VD: 0123456789"></div>
                <small id="withdraw-account-error" style="color:#dc2626;display:none;margin-top:4px"></small>
              </div>
              <button type="submit" class="btn btn-primary full" style="margin-top:6px;padding:11px 20px;justify-self:start">Rút tiền về tài khoản</button>
            </form>

            <div class="list-title" style="margin-top:18px">Lịch sử rút tiền</div>
            <table>
              <thead><tr><th>Ngày</th><th>Ngân hàng nhận</th><th>Số tiền</th><th>Trạng thái</th></tr></thead>
              <tbody id="withdrawal-history">
                @if (!withdrawals.Any())
                {
                    <tr><td colspan="4" style="text-align:center;color:var(--ink-faint)">Chưa có lần rút tiền nào.</td></tr>
                }
                @foreach (var w in withdrawals)
                {
                    <tr>
                      <td class="mono">@w.CreatedAt.ToString("dd/MM HH:mm")</td>
                      <td>@w.BankInfo</td>
                      <td class="mono">@w.Amount.ToString("N0")đ</td>
                      <td><span class="status-pill approved">Thành công</span></td>
                    </tr>
                }
              </tbody>
            </table>
          </div>

          <div class="card">
            <div class="list-title">Lịch sử giao dịch</div>
            <table>
              <thead><tr><th>Ngày</th><th>Tuyến</th><th>Phương thức</th><th>Số tiền</th><th>Trạng thái</th></tr></thead>
              <tbody id="transaction-history">
                @if (!txs.Any())
                {
                    <tr><td colspan="5" style="text-align:center;color:var(--ink-faint)">Chưa có giao dịch nào.</td></tr>
                }
                @foreach (var t in txs)
                {
                    <tr>
                      <td class="mono">@t.Date.ToString("dd/MM")</td>
                      <td>@t.RouteFrom → @t.RouteTo</td>
                      <td>
                        @if (t.PaymentMethod == "online")
                        {
                            <span class="method-tag online">Online</span>
                        }
                        else
                        {
                            <span class="method-tag cash">Tiền mặt</span>
                        }
                      </td>
                      <td class="mono">@t.Amount.ToString("N0")đ</td>
                      <td><span class="status-pill @StatusClass(t.Status)">@StatusLabel(t.Status)</span></td>
                    </tr>
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<script src="~/assets/common.js"></script>
<script>
  async function saveProfile(e){
    e.preventDefault();
    const form = document.getElementById('profile-form');
    const emailInput = document.getElementById('profile-email');
    const emailError = document.getElementById('profile-email-error');
    const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

    if (emailInput.value && !emailRegex.test(emailInput.value)) {
      emailError.textContent = 'Vui lòng nhập đúng định dạng email (VD: ten@example.com).';
      emailError.style.display = 'block';
      emailInput.focus();
      return false;
    }
    emailError.style.display = 'none';

    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await apiFetch('/api/passenger/profile', { method: 'PUT', body: JSON.stringify(data) });
      alert(res.message);
    } catch (err) {
      alert(err.message);
    }
    return false;
  }

  // Số dư ví hiện tại, dùng để giới hạn số tiền rút tối đa và cho nút "Rút hết".
  const walletBalance = @Json.Serialize((long)Model.WalletBalance);
  const amountInput = document.getElementById('withdraw-amount');
  const amountError = document.getElementById('withdraw-amount-error');
  const bankInput = document.getElementById('withdraw-bank');
  const bankError = document.getElementById('withdraw-bank-error');
  const accountInput = document.getElementById('withdraw-account');
  const accountError = document.getElementById('withdraw-account-error');

  if (walletBalance <= 0) {
    amountInput.disabled = true;
    amountInput.placeholder = 'Ví chưa có số dư';
  }

  function validateWithdrawAmount(){
    const raw = amountInput.value;
    if (walletBalance <= 0) {
      amountError.textContent = 'Ví của bạn chưa có số dư để rút.';
      amountError.style.display = 'block';
      return false;
    }
    if (!raw) {
      amountError.textContent = 'Vui lòng nhập số tiền muốn rút.';
      amountError.style.display = 'block';
      return false;
    }
    const value = Number(raw);
    if (!Number.isFinite(value) || value <= 0) {
      amountError.textContent = 'Vui lòng nhập số tiền lớn hơn 0.';
      amountError.style.display = 'block';
      return false;
    }
    if (value > walletBalance) {
      amountError.textContent = `Số tiền vượt quá số dư ví. Số dư hiện tại: ${walletBalance.toLocaleString('vi-VN')}đ.`;
      amountError.style.display = 'block';
      return false;
    }
    amountError.style.display = 'none';
    return true;
  }

  function validateBank(){
    if (!bankInput.value.trim()) {
      bankError.textContent = 'Vui lòng nhập tên ngân hàng nhận tiền.';
      bankError.style.display = 'block';
      return false;
    }
    bankError.style.display = 'none';
    return true;
  }

  function validateAccount(){
    if (!accountInput.value.trim()) {
      accountError.textContent = 'Vui lòng nhập số tài khoản.';
      accountError.style.display = 'block';
      return false;
    }
    accountError.style.display = 'none';
    return true;
  }

  amountInput.addEventListener('input', validateWithdrawAmount);
  bankInput.addEventListener('input', validateBank);
  accountInput.addEventListener('input', validateAccount);

  async function withdrawWallet(e){
    e.preventDefault();
    const form = document.getElementById('withdraw-form');

    const amountOk = validateWithdrawAmount();
    const bankOk = validateBank();
    const accountOk = validateAccount();
    if (!amountOk) { amountInput.focus(); return false; }
    if (!bankOk) { bankInput.focus(); return false; }
    if (!accountOk) { accountInput.focus(); return false; }

    const data = Object.fromEntries(new FormData(form).entries());
    data.amount = Number(data.amount);
    try {
      const res = await apiFetch('/api/passenger/wallet/withdraw', { method: 'POST', body: JSON.stringify(data) });
      alert(res.message);
      window.location.reload();
    } catch (err) {
      alert(err.message);
    }
    return false;
  }
</script>
</body>
</html>
